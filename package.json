{
  "name": "fontend-auto-task",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "check-types": "tsc --pretty --noEmit",
    "pre-commit": "npm run check-types && npm run lint:fix && npm run prettier:fix",
    "test-all": "npm run check-types && npm run lint:fix && npm run prettier && npm run build ",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.{ts,html,css,scss}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/core": "17.3.8",
    "@angular/animations": "17.3.10",
    "@angular/cdk": "17.3.10",
    "@angular/cli": "17.3.8",
    "@angular/common": "17.3.10",
    "@angular/compiler": "17.3.10",
    "@angular/compiler-cli": "17.3.10",
    "@angular/core": "17.3.10",
    "@angular/forms": "17.3.10",
    "@angular/platform-browser": "17.3.10",
    "@angular/platform-browser-dynamic": "17.3.10",
    "@angular/router": "17.3.10",
    "@hgiasac/stringee-types": "0.1.1",
    "@ng-select/ng-select": "11.2.0",
    "angular-calendar": "0.31.0",
    "angularx-flatpickr": "7.3.0",
    "bootstrap": "5.3.2",
    "calendar-utils": "0.10.4",
    "date-fns": "2.30.0",
    "lodash": "4.17.21",
    "moment": "2.29.4",
    "ng2-ckeditor": "1.3.6",
    "ngx-bootstrap": "12.0.0",
    "ngx-color-picker": "12.0.0",
    "ngx-currency": "2.5.3",
    "ngx-mask": "16.4.2",
    "ngx-toastr": "17.0.2",
    "rxjs": "7.8.0",
    "slug": "5.2.0",
    "smaxapp": "16.4.4",
    "stringee": "2.9.3",
    "stringee-chat-js-sdk": "0.2.0",
    "tslib": "2.3.0",
    "uuid": "8.3.2",
    "xlsx": "0.18.5",
    "zone.js": "0.14.6"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "17.3.8",
    "@angular-eslint/builder": "17.5.2",
    "@angular-eslint/eslint-plugin": "17.5.2",
    "@angular-eslint/eslint-plugin-template": "17.5.2",
    "@angular-eslint/schematics": "17.5.2",
    "@angular-eslint/template-parser": "17.5.2",
    "@types/jasmine": "4.3.0",
    "@types/jest": "29.5.12",
    "@types/lodash": "4.14.202",
    "@types/uuid": "9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "husky": "8.0.3",
    "jasmine-core": "4.6.0",
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "prettier": "3.1.1",
    "typescript": "5.4.5"
  }
}
